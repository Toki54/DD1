{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}



{% block body %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/register.css') }}">
{% endblock %}



<div class="auth-page">
    <div class="auth-card">

        <header class="auth-header">
            <h1><span class="highlight">Créer</span> un compte</h1>
            <p>Inscris-toi pour accéder aux profils et aux messages.</p>
        </header>

        {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message }}
        </div>
        {% endfor %}

        {{ form_start(registrationForm, { 'attr': {'class': 'auth-form'} }) }}

        <div class="form-group">
            {{ form_row(registrationForm.email) }}
        </div>

        <div class="form-group">
            {{ form_row(registrationForm.pseudo) }}
        </div>

        <div class="form-group">
            {{ form_row(registrationForm.plainPassword, { label: 'Mot de passe' }) }}
        </div>

        <div class="form-group captcha">
            <div class="g-recaptcha" data-sitekey="{{ recaptcha_site_key }}"></div>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            S'inscrire
        </button>

        <div class="auth-bottom">

            <div class="agree-row">
            
                <label class="checkbox-wrapper">
                    {{ form_widget(registrationForm.agreeTerms) }}
            
                    <span class="custom-checkbox"></span>
            
                    <span class="label-text">
                        J’accepte les conditions
                        <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">
                            (lire)
                        </a>
                    </span>
                </label>
            
                {{ form_errors(registrationForm.agreeTerms) }}
            
            </div>

            <div class="auth-footer">
                <span>Déjà un compte ?</span>
                <a href="{{ path('app_login') }}">Se connecter</a>
            </div>

        </div>

        {{ form_end(registrationForm) }}

    </div>
</div>

{# MODAL #}
<div class="modal fade" id="termsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content custom-modal">
            <div class="modal-header">
                <h5 class="modal-title">Conditions d’utilisation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <ul>
                    <li>Être majeur et fournir des informations exactes.</li>
                    <li>Respecter les autres utilisateurs.</li>
                    <li>Pas de contenu illégal ou abusif.</li>
                    <li>Accès Premium selon abonnement.</li>
                    <li>Suspension possible en cas d’abus.</li>
                </ul>
            </div>

            <div class="modal-footer">
                <button class="btn btn-outline" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>
<script src="https://www.google.com/recaptcha/api.js" async defer></script>
{% endblock %}