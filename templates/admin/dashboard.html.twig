{% extends 'base.html.twig' %}
{% block title %}Administration{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}<section class="admin-page"><header class="admin-hero"><div><div class="admin-kicker">Espace sécurisé</div><h1 class="admin-title">Tableau de bord</h1><p class="admin-subtitle">Gérez les membres, les abonnements et les données modérées.</p></div></header><div class="admin-grid"><article class="admin-card"><small>Membres</small><strong>{{ userCount }}</strong></article><article class="admin-card"><small>Abonnements</small><strong>{{ subscriptionCount }}</strong></article><article class="admin-card"><small>Premium actifs</small><strong>{{ activeSubscriptionCount }}</strong></article><article class="admin-card"><small>Messages</small><strong>{{ messageCount }}</strong></article></div><section class="admin-panel"><div class="admin-toolbar"><h2>Gestion</h2></div><div class="admin-actions"><a class="admin-action" href="{{ path('app_user_index') }}"><strong>Utilisateurs</strong><span>Consulter, modifier ou supprimer les comptes.</span></a><a class="admin-action" href="{{ path('admin_subscriptions_index') }}"><strong>Abonnements</strong><span>Contrôler les accès Premium et leurs dates.</span></a><a class="admin-action" href="{{ path('app_deleted_conversations') }}"><strong>Historique supprimé</strong><span>Voir les conversations et messages archivés.</span></a></div></section></section>{% endblock %}
