{% extends 'base.html.twig' %}

{% block title %}Utilisateur · Administration{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}

{% block body %}
    <section class="admin-page"><header class="admin-hero"><div><div class="admin-kicker">Fiche membre</div><h1 class="admin-title">{{ user.pseudo }}</h1><p class="admin-subtitle">Informations et droits du compte.</p></div><a class="admin-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier</a></header><section class="admin-panel">

    <table class="admin-table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ user.pseudo }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ user.email }}</td>
            </tr>
            <tr>
                <th>Roles</th>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
            </tr>
            <tr>
            </tr>
            <tr>
                <th>Pseudo</th>
                <td>{{ user.pseudo }}</td>
            </tr>
        </tbody>
    </table>

    </section><p style="margin-top:16px"><a class="admin-button" href="{{ path('app_user_index') }}">← Retour aux utilisateurs</a></p>{{ include('user/_delete_form.html.twig') }}</section>
{% endblock %}
