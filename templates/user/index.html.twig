{% extends 'base.html.twig' %}

{% block title %}User index{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}

{% block body %}
    <section class="admin-page"><header class="admin-hero"><div><div class="admin-kicker">Administration</div><h1 class="admin-title">Utilisateurs</h1><p class="admin-subtitle">Gestion des comptes membres.</p></div><a class="admin-primary" href="{{ path('app_user_new') }}">Créer un compte</a></header><section class="admin-panel">

    <table class="admin-table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Email</th>
                <th>Roles</th>
                <th>Pseudo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.email }}</td>
                <td>{{ user.roles ? user.roles|json_encode : '' }}</td>
                <td>{{ user.pseudo }}</td>
                <td>
                    <a href="{{ path('app_user_show', {'id': user.id}) }}">Voir</a> · <a href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun utilisateur trouvé.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    </section></section>
{% endblock %}
