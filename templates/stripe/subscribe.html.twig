{% extends 'base.html.twig' %}

{% block title %}Passe Premium{% endblock %}

{% block body %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/abo.css') }}">
{% endblock %}



<div class="abo-page">
    <div class="account-status-card">
    
        {% if is_granted('ROLE_PREMIUM') and subscription %}
    
        <div class="status-badge premium">
            ⭐ Premium actif
        </div>
    
        <h2 class="status-title">
            Vous êtes membre Premium
        </h2>
    
        <p class="status-description">
            Votre abonnement est actuellement actif et vous donne accès à toutes les fonctionnalités du site.
        </p>
    
        <div class="status-grid">
    
            <div class="status-item">
                <span>Abonnement</span>
                <strong>{{ subscription.plan }}</strong>
            </div>
    
            <div class="status-item">
                <span>Expiration</span>
                <strong>{{ subscription.endDate|date('d/m/Y') }}</strong>
            </div>
    
        </div>
    
        <div class="status-features">
    
            <div class="status-feature">
                ♾ Profils illimités
            </div>
    
            <div class="status-feature">
                ❤️ Likes illimités
            </div>
    
            <div class="status-feature">
                💌 Messages illimités
            </div>
    
            <div class="status-feature">
                👀 Toutes les photos visibles
            </div>
    
            <div class="status-feature">
                🔥 Priorité dans les résultats
            </div>
    
            <div class="status-feature">
                ⭐ Badge Premium
            </div>
    
        </div>
    
        {% else %}
    
        <div class="status-badge basic">
            Compte Basic
        </div>
    
        <h2 class="status-title">
            Version gratuite
        </h2>
    
        <p class="status-description">
            Vous utilisez actuellement la version gratuite avec certaines limitations.
        </p>
    
        <div class="status-grid">
    
            <div class="status-item">
                <span>Profils consultables</span>
                <strong>10 / jour</strong>
            </div>
    
            <div class="status-item">
                <span>Messages</span>
                <strong>5 / jour</strong>
            </div>
    
        </div>
    
        <div class="status-features">
    
            <div class="status-feature">
                ✅ Voir des profils
            </div>
    
            <div class="status-feature">
                ✅ 5 messages par jour
            </div>
    
            <div class="status-feature disabled">
                ❌ Profils illimités
            </div>
    
            <div class="status-feature disabled">
                ❌ Likes illimités
            </div>
    
            <div class="status-feature disabled">
                ❌ Messages illimités
            </div>
    
            <div class="status-feature disabled">
                ❌ Toutes les photos visibles
            </div>
    
            <div class="status-feature disabled">
                ❌ Priorité dans les résultats
            </div>
    
            <div class="status-feature disabled">
                ❌ Badge Premium
            </div>
    
        </div>
    
        {% endif %}
    
    </div>

    <section class="abo-hero">
        <div class="hero-badge">
            ✨ Offre Premium
        </div>

        <h1 class="hero-title">
            Passe <span>Premium</span>
        </h1>

        <p class="hero-text">
            Débloque l'expérience complète :
            profils illimités, photos non floutées,
            likes sans limite, visites et avantages exclusifs.
        </p>
    </section>

    <div class="abo-layout">

        <div>

            <div class="plans-grid">

                <div class="main-plans">

                    <button type="button" class="subscription-card" data-plan="1 mois - 15 €">

                        <div class="plan-name">
                            1 Mois
                        </div>

                        <div class="plan-price">
                            15€
                        </div>

                        <div class="plan-desc">
                            Accès Premium complet pendant 1 mois.
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                    <button type="button" class="subscription-card featured" data-plan="3 mois - 30 €">

                        <div class="plan-badge">
                            ⭐ Meilleur choix
                        </div>

                        <div class="plan-name">
                            3 Mois
                        </div>

                        <div class="plan-price">
                            30€
                        </div>

                        <div class="plan-desc">
                            L'offre la plus populaire avec le meilleur rapport qualité/prix.
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                    <button type="button" class="subscription-card" data-plan="1 an - 80 €">

                        <div class="plan-name">
                            1 An
                        </div>

                        <div class="plan-price">
                            80€
                        </div>

                        <div class="plan-desc">
                            Une année complète d'accès Premium.
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                </div>

                <div class="secondary-plans">

                    <button type="button" class="subscription-card" data-plan="1 semaine - 5 €">

                        <div class="plan-name">
                            1 Semaine
                        </div>

                        <div class="plan-price">
                            5€
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                    <button type="button" class="subscription-card" data-plan="6 mois - 50 €">

                        <div class="plan-name">
                            6 Mois
                        </div>

                        <div class="plan-price">
                            50€
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                    <button type="button" class="subscription-card" data-plan="À vie - 100 €">

                        <div class="plan-badge">
                            ♾ Définitif
                        </div>

                        <div class="plan-name">
                            À Vie
                        </div>

                        <div class="plan-price">
                            100€
                        </div>

                        <div class="plan-btn">
                            Choisir
                        </div>

                    </button>

                </div>

            </div>

            <div class="features-card">

                <h2 class="features-title">
                    Ce que débloque Premium
                </h2>

                <div class="features-grid">

                    <div class="feature">
                        ♾ Profils illimités
                    </div>

                    <div class="feature">
                        ❤️ Likes illimités
                    </div>

                    <div class="feature">
                        👀 Toutes les photos visibles
                    </div>

                    <div class="feature">
                        🔥 Priorité dans les résultats
                    </div>

                    <div class="feature">
                        ⭐ Badge Premium
                    </div>

                    <div class="feature">
                        🚀 Expérience complète
                    </div>

                </div>

            </div>

        </div>

        <aside>

            <div class="summary-card">

                <div class="summary-title">
                    Votre choix
                </div>

                <div class="summary-row">

                    <div class="summary-label">
                        Abonnement
                    </div>

                    <div class="summary-value" id="plan-name">
                        Aucun
                    </div>

                </div>

                <div class="summary-row">

                    <div class="summary-label">
                        Durée
                    </div>

                    <div class="summary-value" id="plan-duration">
                        -
                    </div>

                </div>

                <div class="summary-price" id="plan-price">
                    0€
                </div>

                <button id="payBtn" type="button" disabled>

                    Payer maintenant

                </button>

                <div class="pay-note">
                    🔒 Paiement sécurisé via Stripe
                </div>

            </div>

        </aside>

    </div>

</div>

<script src="https://js.stripe.com/v3/"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        const stripe = Stripe("{{ stripe_public_key }}");
        const csrfToken = "{{ csrf_token('stripe_checkout') }}";

        const payBtn = document.getElementById('payBtn');

        const planName =
            document.getElementById('plan-name');

        const planDuration =
            document.getElementById('plan-duration');

        const planPrice =
            document.getElementById('plan-price');

        let selectedPlan = null;

        const plans = {

            '1 semaine - 5 €': {
                duration: '1 semaine',
                price: '5€'
            },

            '1 mois - 15 €': {
                duration: '1 mois',
                price: '15€'
            },

            '3 mois - 30 €': {
                duration: '3 mois',
                price: '30€'
            },

            '6 mois - 50 €': {
                duration: '6 mois',
                price: '50€'
            },

            '1 an - 80 €': {
                duration: '1 an',
                price: '80€'
            },

            'À vie - 100 €': {
                duration: 'Illimité',
                price: '100€'
            }
        };

        document
            .querySelectorAll('.subscription-card')
            .forEach(card => {

                card.addEventListener('click', () => {

                    const plan = card.dataset.plan;

                    selectedPlan = plan;

                    document
                        .querySelectorAll('.subscription-card')
                        .forEach(c => c.classList.remove('selected'));

                    card.classList.add('selected');

                    planName.textContent = plan;

                    planDuration.textContent =
                        plans[plan].duration;

                    planPrice.textContent =
                        plans[plan].price;

                    payBtn.disabled = false;

                });

            });

        payBtn.addEventListener('click', async () => {

            if (!selectedPlan) return;

            payBtn.disabled = true;
            payBtn.textContent = 'Redirection...';

            try {

                const response = await fetch(
                    "{{ path('app_stripe_checkout') }}",
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify({
                            plan: selectedPlan,
                            _token: csrfToken
                        })
                    }
                );

                const data = await response.json();

                if (!response.ok || !data.id) {

                    payBtn.disabled = false;
                    payBtn.textContent =
                        'Payer maintenant';

                    alert(
                        data.error ||
                        'Erreur Stripe'
                    );

                    return;
                }

                const result =
                    await stripe.redirectToCheckout({
                        sessionId: data.id
                    });

                if (result.error) {

                    payBtn.disabled = false;

                    payBtn.textContent =
                        'Payer maintenant';

                    alert(result.error.message);
                }

            } catch (e) {

                payBtn.disabled = false;

                payBtn.textContent =
                    'Payer maintenant';

                alert('Erreur réseau');
            }

        });

    });
</script>

{% endblock %}
