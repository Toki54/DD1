{% extends 'base.html.twig' %}

{% block title %}Visites et Likes de mon profil{% endblock %}



{% block body %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/likes.css') }}">
{% endblock %}
<div class="likes-page">

    <header class="page-header">
        <h1>Visites et Likes</h1>
        <p>Consulte qui a visité ton profil et qui t’a liké.</p>
    </header>

    {% if not is_granted('ROLE_PREMIUM') %}
    <div class="alert alert-warning premium-lock">
        <strong>Accès Premium</strong> : fonctionnalité réservée.
        <a href="{{ path('app_stripe_subscribe') }}">S’abonner</a>
    </div>

    <div class="tabs disabled">
        <button class="tab active">Visites <span>{{ visitorProfiles|length }}</span></button>
        <button class="tab">Likes <span>{{ likerProfiles|length }}</span></button>
    </div>

    <div class="empty">
        Contenu verrouillé. Passe premium pour débloquer.
    </div>

    {% else %}

    <div class="tabs">
        <button class="tab active" data-tab="visits">
            Visites <span>{{ visitorProfiles|length }}</span>
        </button>
        <button class="tab" data-tab="likes">
            Likes <span>{{ likerProfiles|length }}</span>
        </button>
    </div>

    <!-- VISITES -->
    <section id="visits" class="tab-content active">
        {% if visitorProfiles is empty %}
        <div class="empty">Aucun visiteur.</div>
        {% else %}
        <div class="profiles-grid">
            {% for profile in visitorProfiles %}
            <article class="profile-card">
                <a href="{{ path('app_profile_view', { id: profile.id }) }}">

                    <img src="{{ asset(profile.avatar ? 'uploads/avatars/' ~ profile.avatar : 'uploads/avatars/default-avatar.png') }}"
                        class="avatar">

                    <div class="infos">
                        <h2>
                            {{ profile.user.pseudo }}
                            <span>{{ profile.city|default('—') }}</span>
                        </h2>

                        <p>
                            {{ profile.sex|default('—') }}
                            {% if profile.age %} • {{ profile.age }} ans{% endif %}
                        </p>
                    </div>

                </a>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    <!-- LIKES -->
    <section id="likes" class="tab-content">
        {% if likerProfiles is empty %}
        <div class="empty">Aucun like.</div>
        {% else %}
        <div class="profiles-grid">
            {% for profile in likerProfiles %}
            <article class="profile-card">
                <a href="{{ path('app_profile_view', { id: profile.id }) }}">

                    <img src="{{ asset(profile.avatar ? 'uploads/avatars/' ~ profile.avatar : 'uploads/avatars/default-avatar.png') }}"
                        class="avatar">

                    <div class="infos">
                        <h2>
                            {{ profile.user.pseudo }}
                            <span>{{ profile.city|default('—') }}</span>
                        </h2>

                        <p>
                            {{ profile.sex|default('—') }}
                            {% if profile.age %} • {{ profile.age }} ans{% endif %}
                        </p>
                    </div>

                </a>
            </article>
            {% endfor %}
        </div>
        {% endif %}
    </section>

    {% endif %}

</div>

<script>
    document.querySelectorAll('.tab').forEach(tab => {
        tab.addEventListener('click', () => {
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'))
            tab.classList.add('active')

            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'))
            document.getElementById(tab.dataset.tab)?.classList.add('active')
        })
    })
</script>

{% endblock %}