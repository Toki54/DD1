{% extends 'base.html.twig' %}

{% block title %}Liste des Profils{% endblock %}



{% block body %}
{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/profiles.css') }}">
{% endblock %}
<section class="list-page">

    <header class="page-header">
        <h1>Liste des profils</h1>
        <p>Trouve des profils selon tes critères.</p>

        {% if app.user and profileViewQuota and profileViewQuota.isLimited %}
        <div class="alert quota-box">
            Profils vus aujourd’hui :
            <strong>{{ profileViewQuota.usedToday }}/{{ profileViewQuota.limit }}</strong>
            — Restants :
            <strong>{{ profileViewQuota.remaining }}</strong>
            <span class="premium-text">    - Abonnement = illimité</span>
        </div>
        {% endif %}
    </header>

    <article class="filter-card">
    
        <header class="filter-header">
            <h2>Filtres</h2>
            <button type="button" id="toggleSortBtn" class="toggle-filter-btn">
                <span class="toggle-icon">⚙️</span>
                <span class="toggle-text">Masquer les filtres</span>
            </button>
        </header>
    
        <div id="filterContent">
    
            <form method="GET" action="{{ path('app_profiles_list') }}" class="filter-form">
    
                <div class="filter-grid">
    
                    <div class="filter-group">
                        <div class="filter-label">Sexe</div>
    
                        {% for s in ['Homme','Femme','Autre'] %}
                        <label>
                            <input type="checkbox" name="sex[]" value="{{ s }}" {% if s in sex %}checked{% endif %}>
                            <span>{{ s }}</span>
                        </label>
                        {% endfor %}
                    </div>
    
                    <div class="filter-group">
                        <div class="filter-label">Situation</div>
    
                        {% for s in ['Celibataire','En couple'] %}
                        <label>
                            <input type="checkbox" name="situation[]" value="{{ s }}" {% if s in situation %}checked{% endif
                                %}>
                            <span>{{ s }}</span>
                        </label>
                        {% endfor %}
                    </div>
    
                    <div class="filter-group">
                        <div class="filter-label">Recherche</div>
    
                        {% for r in ['Homme','Femme','Couple'] %}
                        <label>
                            <input type="checkbox" name="research[]" value="{{ r }}" {% if r in research %}checked{% endif
                                %}>
                            <span>{{ r }}</span>
                        </label>
                        {% endfor %}
                    </div>
    
                    <div class="filter-group">
                        <label class="filter-label" for="filter-department">Département</label>

                        <select
                            id="filter-department"
                            name="department"
                            data-cities-url="{{ path('app_profile_cities', {'department': 'ZZ'}) }}"
                        >
                            <option value="">Tous les départements</option>
                            {% for label, code in departments %}
                                <option value="{{ code }}" {% if department == code %}selected{% endif %}>
                                    {{ label }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="filter-group">
                        <label class="filter-label" for="filter-city">Ville</label>

                        <select id="filter-city" name="city" {% if not department %}disabled{% endif %}>
                            <option value="">Toutes les villes</option>
                            {% for availableCity in cities %}
                                <option value="{{ availableCity }}" {% if city == availableCity %}selected{% endif %}>
                                    {{ availableCity }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
    
                </div>
    
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">
                        Appliquer les filtres
                    </button>
                </div>
    
            </form>
    
        </div>
    
    </article>

    {% set quotaReached = (app.user and profileViewQuota and profileViewQuota.isLimited and profileViewQuota.remaining
    <= 0) %} {% if quotaReached %} <div class="alert warning">
        Limite atteinte :
        <strong>{{ profileViewQuota.limit }}</strong> profils/jour.
        <a href="{{ path('app_stripe_subscribe') }}">Passer premium</a>
        </div>
        {% endif %}

        <section class="profiles-grid">

            {% for profile in profiles %}
            {% if profile.user.pseudo != app.user.pseudo %}
            {% include 'profile/_card.html.twig' with { profile: profile } %}
            {% endif %}
            {% endfor %}

        </section>

</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {

        const button =
            document.getElementById('toggleSortBtn');

        const content =
            document.getElementById('filterContent');

        const text =
            button.querySelector('.toggle-text');

        button.addEventListener('click', () => {

            content.classList.toggle('hidden');

            if (content.classList.contains('hidden')) {
                text.textContent = 'Afficher les filtres';
            } else {
                text.textContent = 'Masquer les filtres';
            }

        });

        const department = document.getElementById('filter-department');
        const city = document.getElementById('filter-city');

        if (!department || !city) {
            return;
        }

        const cityUrlTemplate = department.dataset.citiesUrl;

        department.addEventListener('change', async () => {
            city.replaceChildren();

            if (!department.value) {
                city.add(new Option('Toutes les villes', ''));
                city.disabled = true;
                return;
            }

            city.disabled = true;
            city.add(new Option('Chargement des villes…', ''));

            try {
                const response = await fetch(
                    cityUrlTemplate.replace('ZZ', encodeURIComponent(department.value)),
                    {headers: {'Accept': 'application/json'}}
                );

                if (!response.ok) {
                    throw new Error('Unable to load cities.');
                }

                const {cities} = await response.json();
                city.replaceChildren(new Option('Toutes les villes', ''));

                cities.forEach((availableCity) => {
                    city.add(new Option(availableCity, availableCity));
                });

                city.disabled = false;
            } catch (error) {
                city.replaceChildren(new Option('Villes indisponibles', ''));
            }
        });

    });
</script>

{% endblock %}
