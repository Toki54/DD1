{% extends 'base.html.twig' %}

{% block title %}Modifier votre profil{% endblock %}



{% block body %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/edit.css') }}">
{% endblock %}
<div class="edit-page">
    <div class="edit-container">

        <header class="edit-header">
            <h1>Modifier votre profil</h1>
            <p>Mettez à jour vos informations et vos photos.</p>
        </header>

        {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'profile-form'}}) }}

        <div class="edit-grid">

            <!-- LEFT -->
            <section class="card panel">

                <h2 class="panel-title">Informations</h2>

                {% if userProfile.avatar %}
                <div class="current-avatar">
                    <img src="{{ asset('uploads/avatars/' ~ userProfile.avatar) }}" class="avatar-preview">
                </div>
                {% endif %}

                <div class="form-row">
                    <div class="field">
                        {{ form_row(form.sex) }}
                    </div>

                    <div class="field">
                        {{ form_row(form.age) }}
                    </div>
                </div>

                <div class="field">
                    {{ form_row(form.situation) }}
                </div>

                <div class="field">
                    {{ form_row(form.biography) }}
                </div>

                <!-- 🔥 CHECKBOX PREMIUM -->
                <div class="field">
                    <label class="custom-label">Je recherche</label>
                    <div class="checkbox-group">
                        {{ form_widget(form.research) }}
                    </div>
                </div>

                <button class="btn btn-primary">Sauvegarder</button>

            </section>

            <!-- RIGHT -->
            <section class="card panel">

                <h2 class="panel-title">Photos & Localisation</h2>

                <div class="field">
                    {{ form_row(form.avatarFile) }}
                </div>

                <div class="form-row">
                    <div class="field">
                        {{ form_row(form.department) }}
                    </div>

                    <div class="field">
                        {{ form_row(form.city) }}
                    </div>
                </div>

                <div class="field">
                    {{ form_row(form.photoFiles) }}
                </div>

                <div class="divider"></div>

                <h3 class="sub-title">Vos photos</h3>

                <div class="photo-gallery">
                    {% for photo in userProfile.photos %}
                    <div class="photo-item">
                        <img src="{{ asset('uploads/photos/' ~ photo) }}" class="photo-thumbnail">
                        <a href="{{ path('app_profile_delete_photo', {'photoFilename': photo}) }}"
                            class="btn btn-danger btn-sm">
                            Supprimer
                        </a>
                    </div>
                    {% else %}
                    <div class="empty">Aucune photo</div>
                    {% endfor %}
                </div>

            </section>

        </div>

        {{ form_end(form) }}

    </div>
</div>
{% endblock %}