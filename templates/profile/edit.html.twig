{% extends 'base.html.twig' %}

{% block title %}Modifier votre profil{% endblock %}



{% block body %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/edit.css') }}">
{% endblock %}
<div class="edit-page">
    <div class="edit-container">

        <header class="edit-header">
            <h1>Modifier votre profil</h1>
            <p>Mettez à jour vos informations et vos photos.</p>
        </header>

        {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        <div class="edit-grid">

            <!-- LEFT -->
            {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'profile-form', 'id': 'profile-edit-form'}}) }}
            <section class="card panel">

                <h2 class="panel-title">Informations</h2>

                <div class="current-avatar">
                    <img
                        src="{{ asset(userProfile.avatar ? 'uploads/avatars/' ~ userProfile.avatar : 'uploads/avatars/default-avatar.png') }}"
                        class="avatar-preview"
                        alt="Photo de profil actuelle"
                        data-avatar-preview>
                </div>

                <div class="field media-upload">
                    {{ form_widget(form.avatarFile, {'attr': {'class': 'media-file-input', 'accept': 'image/jpeg,image/png,image/gif'}}) }}
                    <label for="{{ form.avatarFile.vars.id }}" class="btn btn-primary media-upload-btn" data-avatar-upload-label>
                        {{ userProfile.avatar ? 'Changer la photo de profil' : 'Choisir une photo de profil' }}
                    </label>
                    {{ form_errors(form.avatarFile) }}
                </div>

                <div class="form-row">
                    <div class="field">
                        {{ form_row(form.age) }}
                    </div>
                </div>

                <div class="field">
                    {{ form_row(form.situation) }}
                </div>

                <div class="field">
                    {{ form_row(form.biography) }}
                </div>

                <!-- 🔥 CHECKBOX PREMIUM -->
                <div class="field">
                    <label class="custom-label">Je recherche</label>
                    <div class="checkbox-group">
                        {{ form_widget(form.research) }}
                    </div>
                </div>

                <div class="form-row">
                    <div class="field">
                        {{ form_label(form.department) }}
                        {{ form_widget(form.department, {'attr': {
                            'class': 'form-control',
                            'data-cities-url': path('app_profile_cities', {'department': 'ZZ'})
                        }}) }}
                        {{ form_errors(form.department) }}
                    </div>

                    <div class="field">
                        {{ form_label(form.city) }}
                        {{ form_widget(form.city, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.city) }}
                    </div>
                </div>

                <button type="submit" class="btn btn-primary save-profile-btn">Sauvegarder</button>

                {{ form_widget(form._token) }}

            </section>
            {{ form_end(form, {'render_rest': false}) }}

            <!-- RIGHT -->
            <section class="card panel gallery-panel">

                <h2 class="panel-title">Photos de galerie</h2>

                <div class="field media-upload gallery-upload">
                    {{ form_widget(form.photoFiles, {'attr': {'class': 'media-file-input', 'accept': 'image/jpeg,image/png', 'form': 'profile-edit-form'}}) }}
                    <label for="{{ form.photoFiles.vars.id }}" class="btn btn-primary media-upload-btn">
                        Ajouter des photos
                    </label>
                    {{ form_errors(form.photoFiles) }}
                </div>

                <div class="photo-gallery">
                    {% for photo in userProfile.photos %}
                        <div class="photo-item">
                            <img src="{{ asset('uploads/photos/' ~ photo) }}" class="photo-thumbnail" alt="Photo de galerie">
                            <form method="post" action="{{ path('app_profile_delete_photo', {'photoFilename': photo}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_photo' ~ photo) }}">
                                <button type="submit" class="btn btn-danger delete-photo-btn">Supprimer</button>
                            </form>
                        </div>
                    {% else %}
                        <div class="empty">Aucune photo</div>
                    {% endfor %}
                </div>

            </section>

        </div>

    </div>
</div>

<script>
    (() => {
        const avatarInput = document.getElementById('{{ form.avatarFile.vars.id }}');
        const avatarButton = document.querySelector('[data-avatar-upload-label]');
        const avatarPreview = document.querySelector('[data-avatar-preview]');

        if (avatarInput && avatarButton && avatarPreview) {
            let previewUrl = null;

            avatarInput.addEventListener('change', () => {
                const [selectedFile] = avatarInput.files;

                if (!selectedFile) {
                    return;
                }

                avatarButton.textContent = 'Changer la photo de profil';

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(selectedFile);
                avatarPreview.src = previewUrl;
            });

            window.addEventListener('beforeunload', () => {
                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }
            });
        }

        const departmentInput = document.getElementById('{{ form.department.vars.id }}');
        const cityInput = document.getElementById('{{ form.city.vars.id }}');

        if (!departmentInput || !cityInput) {
            return;
        }

        const cityUrlTemplate = departmentInput.dataset.citiesUrl;

        const loadCities = async () => {
            const department = departmentInput.value;
            cityInput.replaceChildren();

            if (!department) {
                cityInput.add(new Option('Choisir d’abord un département', ''));
                cityInput.disabled = true;
                return;
            }

            cityInput.disabled = true;
            cityInput.add(new Option('Chargement des villes…', ''));

            try {
                const response = await fetch(
                    cityUrlTemplate.replace('ZZ', encodeURIComponent(department)),
                    {headers: {'Accept': 'application/json'}}
                );

                if (!response.ok) {
                    throw new Error('Unable to load cities.');
                }

                const {cities} = await response.json();
                cityInput.replaceChildren(new Option('Choisir une ville', ''));

                cities.forEach((city) => {
                    cityInput.add(new Option(city, city));
                });

                cityInput.disabled = false;
            } catch (error) {
                cityInput.replaceChildren(new Option('Villes indisponibles', ''));
            }
        };

        if (!departmentInput.value) {
            cityInput.disabled = true;
        }

        departmentInput.addEventListener('change', loadCities);
    })();
</script>
{% endblock %}
