{% extends 'base.html.twig' %}

{% block title %}Profil{% endblock %}



{% block body %}
{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/Profile.css') }}">
{% endblock %}
<div class="profile-page">
    <div class="profile-container">
        {% for message in app.flashes('success') %}
            <div class="alert alert-success" role="alert">{{ message }}</div>
        {% endfor %}

        <header class="profile-top">
            <h1 class="pseudo">Mon profil</h1>
            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">Éditer mon profil</a>
        </header>

        {% set photos = userProfile.photos|default([]) %}

        <div class="profile-layout">

            <!-- LEFT: Avatar + Photos -->
            <section class="card panel">
                <h2 class="panel-title">Photos</h2>

                <div class="avatar-block">
                    {% if userProfile.avatar %}
                        <img src="{{ asset('uploads/avatars/' ~ userProfile.avatar) }}" alt="Avatar" class="avatar">
                    {% else %}
                        <img src="{{ asset('uploads/avatars/default-avatar.png') }}" alt="Avatar" class="avatar">
                    {% endif %}

                    <div class="avatar-meta">
                        <div class="avatar-name">{{ app.user.pseudo }}</div>
                    </div>
                </div>

                <div class="divider"></div>

                <h3 class="sub-title">Galerie</h3>

                {% if photos is not empty %}
                    <div class="photo-gallery photo-gallery-rect">
                        {% for photo in photos %}
                            <img
                                src="{{ asset('uploads/photos/' ~ photo) }}"
                                alt="User Photo"
                                class="photo-thumbnail js-profile-photo"
                                data-photo-index="{{ loop.index0 }}"
                            >
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="empty">Aucune photo uploadée.</div>
                {% endif %}
            </section>

            <!-- RIGHT: Infos -->
            <section class="card panel">
                <h2 class="panel-title">Informations</h2>

                <div class="info-grid">
                    <div class="info-item">
                        <div class="info-label">Sexe</div>
                        <div class="info-value">{{ userProfile.sex|default('Non spécifié.') }}</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Âge</div>
                        <div class="info-value">{{ userProfile.age|default('Non spécifié.') }}</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Situation</div>
                        <div class="info-value">{{ userProfile.situation|default('Non renseigné.') }}</div>
                    </div>

                    {% if userProfile.research is not empty %}
                        <div class="info-item info-wide">
                            <div class="info-label">Recherche</div>
                            <div class="info-value">{{ userProfile.research|join(', ') }}</div>
                        </div>
                    {% endif %}

                    <div class="info-item">
                        <div class="info-label">Département</div>
                        <div class="info-value">{{ userProfile.department|default('Non spécifié.') }}</div>
                    </div>

                    <div class="info-item">
                        <div class="info-label">Ville</div>
                        <div class="info-value">{{ userProfile.city|default('Non spécifiée.') }}</div>
                    </div>
                </div>

                <div class="divider"></div>

                <div class="desc-block">
                    <h3 class="sub-title">Description</h3>
                    <p class="desc-text">{{ userProfile.biography|default('Aucune biographie disponible.') }}</p>
                </div>
            </section>

        </div>
    </div>
</div>

<!-- Visionneuse de photos -->
<div id="photoCarousel" class="profile-lightbox" aria-hidden="true">
    <div class="profile-lightbox-content" role="dialog" aria-modal="true" aria-label="Galerie de photos">
        <button type="button" id="closePhotoCarousel" class="profile-lightbox-close" aria-label="Fermer">×</button>
        <button type="button" id="profileCarouselPrevious" class="profile-lightbox-nav previous" aria-label="Photo précédente">‹</button>

        <div class="profile-lightbox-slides">
            {% for photo in photos %}
                <img src="{{ asset('uploads/photos/' ~ photo) }}" class="profile-lightbox-image" alt="Photo {{ loop.index }}">
            {% endfor %}
        </div>

        <button type="button" id="profileCarouselNext" class="profile-lightbox-nav next" aria-label="Photo suivante">›</button>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const lightbox = document.getElementById('photoCarousel');
        const images = Array.from(document.querySelectorAll('.profile-lightbox-image'));
        const closeButton = document.getElementById('closePhotoCarousel');
        const previousButton = document.getElementById('profileCarouselPrevious');
        const nextButton = document.getElementById('profileCarouselNext');
        let currentIndex = 0;

        const displayImage = (index) => {
            currentIndex = (index + images.length) % images.length;
            images.forEach((image, imageIndex) => {
                image.classList.toggle('is-active', imageIndex === currentIndex);
            });
        };

        const closeLightbox = () => {
            lightbox.classList.remove('is-open');
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('lightbox-open');
        };

        document.querySelectorAll('.js-profile-photo').forEach((photo) => {
            photo.addEventListener('click', () => {
                displayImage(Number(photo.dataset.photoIndex));
                lightbox.classList.add('is-open');
                lightbox.setAttribute('aria-hidden', 'false');
                document.body.classList.add('lightbox-open');
            });
        });

        previousButton?.addEventListener('click', () => displayImage(currentIndex - 1));
        nextButton?.addEventListener('click', () => displayImage(currentIndex + 1));
        closeButton?.addEventListener('click', closeLightbox);

        lightbox.addEventListener('click', (event) => {
            if (event.target === lightbox) closeLightbox();
        });

        document.addEventListener('keydown', (event) => {
            if (!lightbox.classList.contains('is-open')) return;
            if (event.key === 'Escape') closeLightbox();
            if (event.key === 'ArrowLeft') displayImage(currentIndex - 1);
            if (event.key === 'ArrowRight') displayImage(currentIndex + 1);
        });
    });
</script>

{% endblock %}
