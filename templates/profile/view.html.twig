{% extends 'base.html.twig' %}

{% block title %}Profil de {{ userProfile.user.pseudo }}{% endblock %}

{% block body %}
{% set viewedIsPremium = ('ROLE_PREMIUM' in userProfile.user.roles) %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('css/profileUser.css') }}">
{% endblock %}

<section class="profile-page">
    <div class="profile-container">

        <header class="profile-header">
            <div class="profile-header-top">

                <h1 class="profile-title">
                    {{ userProfile.user.pseudo }}

                    {% if viewedIsPremium %}
                    <span class="premium-logo">⭐</span>
                    {% endif %}
                </h1>

                {% if viewedIsPremium %}
                <span class="premium-badge-header">⭐ Premium</span>
                {% endif %}

            </div>

            <p>Profil public</p>
        </header>

        <div class="profile-grid">

            <article class="card panel profile-card detail-card">

                <h2 class="panel-title">Informations</h2>

                <div class="profile-top">

                    <img class="avatar"
                        src="{{ asset(userProfile.avatar ? 'uploads/avatars/' ~ userProfile.avatar : 'uploads/avatars/default-avatar.png') }}"
                        alt="Avatar de {{ userProfile.user.pseudo }}" />

                    <div class="profile-meta">

                        <div class="meta-item">
                            <span class="meta-label">Sexe</span>

                            <span class="meta-value">
                                {% set sexValue = (userProfile.sex is iterable
                                ? userProfile.sex|join(', ')
                                : userProfile.sex|default('Non spécifié')) %}

                                {{ sexValue }}
                            </span>
                        </div>

                        <div class="meta-item">
                            <span class="meta-label">Âge</span>
                            <span class="meta-value">{{ userProfile.age ? userProfile.age ~ ' ans' : 'Non renseigné' }}</span>
                        </div>

                        <div class="meta-item">
                            <span class="meta-label">Situation</span>

                            <span class="meta-value">
                                {{ userProfile.situation is iterable
                                ? userProfile.situation|join(', ')
                                : userProfile.situation|default('Non renseignée') }}
                            </span>
                        </div>

                        <div class="meta-item">
                            <span class="meta-label">Ici pour</span>

                            <span class="meta-value">
                                {{ userProfile.research is iterable
                                ? userProfile.research|join(', ')
                                : userProfile.research|default('Non spécifié') }}
                            </span>
                        </div>

                        <div class="meta-item">
                            <span class="meta-label">Ville</span>

                            <span class="meta-value">
                                {{ userProfile.city is iterable
                                ? userProfile.city|join(', ')
                                : userProfile.city|default('Non renseignée') }}
                            </span>
                        </div>

                    </div>

                </div>

                <div class="divider"></div>

                <div class="bio-block">
                    <p class="bio-text">
                        {{ userProfile.biography is iterable
                        ? userProfile.biography|join(', ')
                        : userProfile.biography|default('Aucune biographie renseignée.') }}
                    </p>
                </div>

                <div class="divider"></div>

                <div class="like-alert" id="like-alert"></div>

                <div class="actions">

                    <a href="{{ path('app_messages', { id: userProfile.user.id }) }}" class="btn btn-primary">
                        💬 Envoyer un message
                    </a>

                    <button type="button" class="btn btn-like js-like-btn"
                        data-url="{{ path('app_profile_like', { id: userProfile.id }) }}"
                        data-token="{{ csrf_token('like' ~ userProfile.id) }}">
                        ❤️ Like
                    </button>

                </div>

            </article>

            <article class="card panel gallery-card">
            
                <h2 class="panel-title">Galerie de photos</h2>
            
                {% set viewerIsPremium = is_granted('ROLE_PREMIUM') %}
            
                {% if viewerIsPremium %}
            
                {% set photos = userProfile.photos|default([]) %}
            
                <div class="photo-gallery">
            
                    {% for photo in photos %}
                    <img src="{{ asset('uploads/photos/' ~ photo) }}" alt="Photo" class="photo-thumbnail js-profile-photo"
                        data-photo-index="{{ loop.index0 }}">
                    {% endfor %}
            
                </div>
            
                {% else %}
            
                <div class="gallery-locked">
            
                    <div class="lock-icon">🔒</div>
            
                    <div class="lock-title">
                        Abonnez-vous pour voir les photos
                    </div>
            
                    <a class="btn btn-primary" href="{{ path('app_stripe_subscribe') }}">
                        S'abonner
                    </a>
            
                </div>
            
                {% endif %}
            
            </article>
            
            {# MODAL EN DEHORS DE LA CARD #}
            {% if viewerIsPremium %}
            
            <div id="photoCarousel" class="profile-lightbox" aria-hidden="true">
                <div class="profile-lightbox-content" role="dialog" aria-modal="true" aria-label="Galerie de photos">
                    <button type="button" id="closePhotoCarousel" class="profile-lightbox-close" aria-label="Fermer" onclick="this.closest('.profile-lightbox').classList.remove('is-open'); this.closest('.profile-lightbox').setAttribute('aria-hidden', 'true'); document.body.classList.remove('lightbox-open');">×</button>
                    <button type="button" id="profileCarouselPrevious" class="profile-lightbox-nav previous" aria-label="Photo précédente">‹</button>

                    <div class="profile-lightbox-slides">
                        {% for photo in photos %}
                            <img src="{{ asset('uploads/photos/' ~ photo) }}" class="profile-lightbox-image" alt="Photo {{ loop.index }}">
                        {% endfor %}
                    </div>

                    <button type="button" id="profileCarouselNext" class="profile-lightbox-nav next" aria-label="Photo suivante">›</button>
                </div>
            </div>
            
            {% endif %}

            </article>

        </div>
    </div>
</section>

<script>
    (() => {
        const initializeCarousel = () => {
            const lightbox = document.getElementById('photoCarousel');
            if (!lightbox || lightbox.dataset.showCarouselInitialized === 'true') return;

            lightbox.dataset.showCarouselInitialized = 'true';

            const images = Array.from(document.querySelectorAll('.profile-lightbox-image'));
            const closeButton = document.getElementById('closePhotoCarousel');
            const previousButton = document.getElementById('profileCarouselPrevious');
            const nextButton = document.getElementById('profileCarouselNext');
            let currentIndex = 0;

            const displayImage = (index) => {
                currentIndex = (index + images.length) % images.length;
                images.forEach((image, imageIndex) => {
                    image.classList.toggle('is-active', imageIndex === currentIndex);
                });
            };

            const closeLightbox = () => {
                lightbox.classList.remove('is-open');
                lightbox.setAttribute('aria-hidden', 'true');
                document.body.classList.remove('lightbox-open');
            };

            document.querySelectorAll('.js-profile-photo').forEach((photo) => {
                photo.addEventListener('click', () => {
                    displayImage(Number(photo.dataset.photoIndex));
                    lightbox.classList.add('is-open');
                    lightbox.setAttribute('aria-hidden', 'false');
                    document.body.classList.add('lightbox-open');
                });
            });

            previousButton?.addEventListener('click', () => displayImage(currentIndex - 1));
            nextButton?.addEventListener('click', () => displayImage(currentIndex + 1));
            closeButton?.addEventListener('click', closeLightbox);

            lightbox.addEventListener('click', (event) => {
                if (event.target === lightbox) closeLightbox();
            });

            document.addEventListener('keydown', (event) => {
                if (!lightbox.classList.contains('is-open')) return;
                if (event.key === 'Escape') closeLightbox();
                if (event.key === 'ArrowLeft') displayImage(currentIndex - 1);
                if (event.key === 'ArrowRight') displayImage(currentIndex + 1);
            });
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initializeCarousel, { once: true });
        } else {
            initializeCarousel();
        }

        document.addEventListener('turbo:load', initializeCarousel);
    })();
</script>
<script src="{{ asset('script/js/profile-detail.js') }}"></script>




{% endblock %}
