<article class="profile-card premium-card">

	<div class="card-inner">

		<div class="card-left">

			<a class="avatar-link" href="{{ path('app_profile_view', { id: profile.id }) }}">

				<div class="avatar-wrap">
					<img src="{{ asset(profile.avatar ? 'uploads/avatars/' ~ profile.avatar : 'uploads/avatars/default-avatar.png') }}"
						alt="Avatar de {{ profile.user.pseudo }}">

						

					{% if 'ROLE_PREMIUM' in profile.user.roles %}
					<span class="premium-dot">⭐</span>
					<span class="premium-badge">Premium</span>
					{% endif %}
				</div>

			</a>

			<div class="left-actions">
				<a href="{{ path('app_messages', { id: profile.user.id }) }}" class="btn btn-primary btn-small">
					Message
				</a>
			</div>
			

		</div>

		<a class="card-right" href="{{ path('app_profile_view', { id: profile.id }) }}">

			<div class="card-main">

				

				<h2 class="name">
					{{ profile.user.pseudo }}
				</h2>

				<div class="meta">
					<span class="pill">{{ profile.sex|default('Inc') }}</span>

					{% if profile.age %}
					<span class="sep">—</span>{{ profile.age }} ans
					{% endif %}
				</div>

				<div class="city">
					📍 {{ profile.city|default('Inconnue') }}
				</div>

				<div class="search">
					💖
					{% if profile.research is iterable %}
					{{ profile.research|join(', ') }}
					{% else %}
					{{ profile.research|default('Non précisé') }}
					{% endif %}
				</div>

				<p class="bio">
					{{ profile.biography|default('Aucune biographie.')|striptags }}
				</p>

			</div>

		</a>

	</div>

</article>