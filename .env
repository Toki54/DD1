# Default environment configuration for Symfony.
#
# This file is committed to Git. Keep only non-sensitive defaults here.
# Put actual local credentials in .env.local (ignored by Git), and configure
# production values directly in the hosting environment.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://db_user:db_password@127.0.0.1:3306/dd?serverVersion=9.1.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=
###< symfony/mailer ###

###> pusher/pusher-php-server ###
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
###< pusher/pusher-php-server ###

###> Google reCAPTCHA ###
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
###< Google reCAPTCHA ###

###> Stripe ###
# Set these in .env.local for development, or in server environment variables
# for production. Keep Stripe keys, webhook secret and Price IDs out of Git.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_WEEK=
STRIPE_PRICE_MONTH=
STRIPE_PRICE_3MONTHS=
STRIPE_PRICE_6MONTHS=
STRIPE_PRICE_YEAR=
STRIPE_PRICE_LIFETIME=
###< Stripe ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###
